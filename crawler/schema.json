{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JaripON Support Program",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "source_id",
    "source_url",
    "crawled_at",
    "title",
    "content_text"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "source": {
      "type": "string",
      "const": "jaripon"
    },
    "source_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "crawled_at": {
      "type": "string",
      "format": "date-time"
    },
    "category": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "경제",
        "주거",
        "진로",
        "건강",
        "법률",
        "기타",
        null
      ]
    },
    "status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "모집예정",
        "모집중",
        "모집종료",
        "결과발표",
        null
      ]
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "region": {
      "type": [
        "string",
        "null"
      ]
    },
    "recruitment": {
      "type": "object",
      "properties": {
        "raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "start_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "end_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "is_evergreen": {
          "type": "boolean"
        },
        "headcount_raw": {
          "type": [
            "string",
            "null"
          ],
          "description": "모집인원 원문(예: '00명 내외'). 상세페이지 접근 차단으로 현재 크롤러는 항상 null."
        }
      }
    },
    "eligibility": {
      "type": "object",
      "description": "모집대상/지원자격/지원요건(연령·조건). 본문에 해당 라벨이 명시된 공고에서만 추출되며, 없으면 null.",
      "properties": {
        "raw": {
          "type": [
            "string",
            "null"
          ],
          "description": "모집대상 원문 전체"
        },
        "age_min": {
          "type": [
            "integer",
            "null"
          ]
        },
        "age_max": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "summary": {
      "type": [
        "string",
        "null"
      ],
      "description": "해당 공고의 간략한 설명(본문 요약). 상세페이지 접근 차단으로 현재 크롤러는 항상 null."
    },
    "application": {
      "type": "object",
      "description": "신청 방법/URL. 상세페이지 접근 차단으로 항상 method/url이 null.",
      "properties": {
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "result": {
      "type": "object",
      "description": "결과발표. 상세페이지 접근 차단으로 항상 null.",
      "properties": {
        "announcement_date_raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "confirmation": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "organization": {
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "manager_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "contact": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "view_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content_text": {
      "type": [
        "string",
        "null"
      ],
      "description": "상세페이지 본문 전체. 상세페이지 접근이 차단되어 항상 null."
    },
    "detail_accessible": {
      "type": "boolean",
      "description": "상세페이지에서 실제로 데이터를 가져왔는지 여부. 현재 크롤러는 목록 카드만 수집하므로 항상 false."
    },
    "attachments": {
      "type": "array",
      "description": "첨부파일 목록. 상세페이지 접근 차단으로 항상 빈 배열.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "url"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "images": {
      "type": "array",
      "description": "이미지 목록. 상세페이지 접근 차단으로 항상 빈 배열.",
      "items": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "alt": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string"
          }
        }
      }
    }
  }
}