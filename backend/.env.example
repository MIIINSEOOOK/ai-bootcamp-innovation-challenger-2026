# 분석 모드: rule(규칙만), ai(AI만), hybrid(규칙과 AI를 함께 사용)
# ai/hybrid 모드에서도 키 누락이나 호출 실패 시 규칙 분석으로 자동 폴백합니다.
ANALYSIS_MODE=hybrid

# 서버 전용 AI API 키입니다. 실제 키를 이 예제 파일이나 Git에 기록하지 마세요.
# 로컬에서는 이 파일을 backend/.env로 복사한 뒤 값만 입력합니다.
AI_API_KEY=

# 사용할 AI 모델명입니다. Responses API의 JSON Schema 구조화 출력을 지원하고
# 현재 API 계정에서 사용할 수 있는 모델인지 확인하세요.
AI_MODEL=gpt-5.4-mini

# 비워 두면 backend/data/app_data.json을 사용합니다.
# 다른 JSON 파일을 사용할 때만 절대 경로나 프로젝트 기준 경로를 입력합니다.
APP_DATA_PATH=

# 로컬 데모 인증용 토큰입니다. 실제 운영 인증 토큰으로 사용하지 마세요.
DEMO_TOKEN=demo-local-token
