{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Persona (자립준비청년 안전망 감지 데모 페르소나)",
  "description": "완전히 가상의 인물/데이터. 실제 개인정보를 포함하지 않는다.",
  "type": "object",
  "required": [
    "persona_id",
    "name",
    "age",
    "case_worker",
    "independence_status",
    "scenario_type",
    "backstory",
    "daily_logs",
    "derived_summary",
    "expected_ai_label",
    "expected_rationale_example",
    "case_history"
  ],
  "properties": {
    "persona_id": { "type": "string" },
    "name": { "type": "string", "description": "가상의 이름(가명)" },
    "age": { "type": "integer" },
    "case_worker": { "type": "string", "description": "담당 전담요원 가명" },
    "independence_status": {
      "type": "object",
      "required": ["care_exit_date", "housing", "employment_education"],
      "properties": {
        "care_exit_date": { "type": "string", "format": "date", "description": "보호종료일" },
        "housing": { "type": "string", "description": "주거 형태" },
        "employment_education": { "type": "string", "description": "취업/학업/훈련 상태" }
      }
    },
    "scenario_type": {
      "type": "string",
      "enum": ["정상 유지형", "점진적 악화형", "급격한 단절형"]
    },
    "scenario_note": {
      "type": "string",
      "description": "같은 scenario_type 안에서의 구체적 변형(서브타입) 설명"
    },
    "complete_silence": {
      "type": "boolean",
      "description": "특정 시점 이후 응답이 단 한 건도 없는 '완전 무응답형'인지 여부"
    },
    "backstory": {
      "type": "string",
      "description": "1~3문장의 배경 서사. 진단/낙인적 표현 대신 상황 설명 중심으로 작성."
    },
    "daily_logs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "sent", "message", "responded", "response_time_minutes", "response_type", "response_text"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "sent": { "type": "boolean", "description": "안부 메시지 발송 여부 (F1)" },
          "message": { "type": ["string", "null"], "description": "발송된 메시지 템플릿" },
          "responded": { "type": "boolean", "description": "응답 여부 (F2)" },
          "response_time_minutes": {
            "type": ["integer", "null"],
            "description": "발송~응답까지 걸린 시간(분). 미응답이면 null."
          },
          "response_type": {
            "type": ["string", "null"],
            "enum": ["좋음", "보통", "힘듦", null],
            "description": "버튼 선택형 응답"
          },
          "response_text": {
            "type": ["string", "null"],
            "description": "자유 텍스트 응답(짧은 예시 문구)"
          }
        }
      }
    },
    "derived_summary": {
      "type": "object",
      "description": "F3(집계) 산출물에 해당하는 요약 지표. AI가 실시간으로 계산할 값의 참고용 스냅샷.",
      "required": [
        "period_start", "period_end", "period_days",
        "response_rate_overall", "response_rate_last_7d", "response_rate_prev_7d",
        "response_rate_change_7d", "max_consecutive_no_response", "current_consecutive_no_response"
      ],
      "properties": {
        "period_start": { "type": "string", "format": "date" },
        "period_end": { "type": "string", "format": "date" },
        "period_days": { "type": "integer" },
        "response_rate_overall": { "type": "number" },
        "response_rate_last_7d": { "type": "number" },
        "response_rate_prev_7d": { "type": "number", "description": "최근 7일 이전, 그 전 7일간 응답률" },
        "response_rate_change_7d": { "type": "number" },
        "max_consecutive_no_response": { "type": "integer" },
        "current_consecutive_no_response": { "type": "integer", "description": "기간 종료 시점 기준 연속 미응답 일수" }
      }
    },
    "expected_ai_label": {
      "type": ["string", "null"],
      "enum": ["정상", "관심 필요", "훼손 의심", null],
      "description": "F4가 판정할 상태 라벨. 페르소나는 원천 데이터(F1~F3)만 제공하므로 항상 null — 실제 F4 로직이 daily_logs/derived_summary를 입력받아 채워야 하는 필드."
    },
    "expected_rationale_example": {
      "type": ["string", "null"],
      "description": "F4가 제시할 판단 근거 텍스트(예: '최근 7일 응답률 86%→29%로 감소, 3일 연속 미응답'). 항상 null — F4 로직의 출력값."
    },
    "case_history": {
      "type": "array",
      "description": "F7 '과거 처리 이력'. 전담요원이 F5 알림을 보고 남기는 사람의 판단 결과라 페르소나 단계에서는 항상 빈 배열.",
      "items": {
        "type": "object",
        "required": ["date", "status", "memo", "case_worker"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "status": { "type": "string", "enum": ["확인완료", "연락필요", "관찰지속"] },
          "memo": { "type": "string" },
          "case_worker": { "type": "string" }
        }
      }
    }
  }
}
